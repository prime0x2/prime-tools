{
  "name": "prime-tools",
  "description": "Dim, blur or hide any part of a web page. Remembers per site. Local-only, open source.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "author": "M. Prime <prime0x2@gmail.com>",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "lint:firefox": "web-ext lint --source-dir .output/firefox-mv3 --warnings-as-errors",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build:e2e && playwright test",
    "build:icons": "node scripts/icons.mjs",
    "postinstall": "wxt prepare",
    "build:e2e": "WXT_E2E=1 wxt build",
    "zip:all": "wxt zip && wxt zip -b firefox",
    "verify": "pnpm compile && pnpm lint && pnpm test && pnpm build && pnpm build:firefox && pnpm lint:firefox",
    "test:e2e:firefox": "WXT_E2E=1 wxt build -b firefox && node e2e-firefox/smoke.mjs",
    "build:store": "WXT_E2E=1 wxt build && node scripts/store-shots.mjs",
    "build:banners": "node scripts/banners.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@playwright/test": "^1.64.1",
    "@resvg/resvg-js": "^2.6.2",
    "happy-dom": "^21.0.4",
    "puppeteer-core": "^24.43.1",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5",
    "web-ext": "^10.8.0",
    "wxt": "^0.21.5"
  },
  "packageManager": "pnpm@10.33.0"
}
